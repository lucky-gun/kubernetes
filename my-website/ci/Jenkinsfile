pipeline {
  agent any

  options {
    disableConcurrentBuilds()
    skipDefaultCheckout(true)                 // 자동 checkout 끄고 우리가 명확히 제어
    timeout(time: 30, unit: 'MINUTES')        // 무한 대기 방지
    buildDiscarder(logRotator(numToKeepStr: '30'))
  }

  parameters {
    string(name: 'NEW_REPLICAS', defaultValue: '2', description: 'mediawiki Deployment replicas 값 (정수)')
    booleanParam(name: 'DRY_RUN', defaultValue: false, description: 'true면 커밋/푸시/PR 생성 없이 변경만 검증')
  }

  environment {
    REPO_SLUG   = "lucky-gun/kubernetes"
    BASE_BRANCH = "main"
    TARGET_FILE = "my-website/gitops/apps/mediawiki/mediawiki.yaml"

    // 커밋 작성자
    GIT_AUTHOR_NAME  = "jenkins-gitops-bot"
    GIT_AUTHOR_EMAIL = "jenkins-gitops-bot@local"
  }

  stages {

    stage('Guard / Validate Inputs') {
      steps {
        script {
          // gitops 브랜치에서 다시 실행되어 루프 도는 경우 방지용(멀티브랜치라면 특히 유용)
          if (env.BRANCH_NAME?.startsWith('gitops-')) {
            currentBuild.description = "Skipped (gitops branch loop guard)"
            error("Skipping build on gitops-* branch to prevent CI loops.")
          }

          // NEW_REPLICAS 검증
          def r = params.NEW_REPLICAS?.trim()
          if (!(r ==~ /^\d+$/) || (r.toInteger() < 0)) {
            error("NEW_REPLICAS must be a non-negative integer. got='${params.NEW_REPLICAS}'")
          }
          echo "NEW_REPLICAS=${r}, DRY_RUN=${params.DRY_RUN}"
        }
      }
    }

    stage('Checkout (pipeline repo) for trace') {
      steps {
        // Jenkinsfile이 어떤 커밋에서 실행됐는지 추적용(브랜치명에 sha 넣는 목적)
        dir('pipeline-src') {
          checkout scm
          script {
            env.PIPELINE_SHA = sh(returnStdout: true, script: "git rev-parse --short=8 HEAD || echo nosha").trim()
            echo "PIPELINE_SHA=${env.PIPELINE_SHA}"
          }
        }
      }
    }

    stage('Prepare GitOps branch name') {
      steps {
        script {
          // CHANGE_ID 같은 예약성 env를 덮어쓰지 말고 별도 변수 사용
          env.GITOPS_ID = "replicas-${params.NEW_REPLICAS}-${env.BUILD_NUMBER}-${env.PIPELINE_SHA}"
          env.GITOPS_BRANCH = "gitops-${env.GITOPS_ID}"
          currentBuild.description = "replicas=${params.NEW_REPLICAS} branch=${env.GITOPS_BRANCH}"
          echo "GITOPS_BRANCH=${env.GITOPS_BRANCH}"
        }
      }
    }

    stage('Clone / Patch / Commit / Push') {
      steps {
        withCredentials([usernamePassword(
          credentialsId: 'github-app',
          usernameVariable: 'GH_USER_IGNORED',   // (안씀) 토큰만 쓰는 구조라서 변수 이름만 남겨둠
          passwordVariable: 'GH_TOKEN'
        )]) {
          sh '''
            set -euo pipefail

            rm -rf work
            mkdir -p work
            cd work

            # --- GitHub HTTPS 인증 토큰을 URL에 박지 않기(로그/remote에 토큰이 남는 문제 방지) ---
            # Git이 Authorization 헤더로 인증하도록 extraheader를 사용
            if command -v base64 >/dev/null 2>&1; then
              AUTH_B64="$(printf "x-access-token:%s" "${GH_TOKEN}" | base64 | tr -d '\\n')"
            else
              AUTH_B64="$(python3 - <<'PY'
import os, base64
t = os.environ["GH_TOKEN"].encode()
print(base64.b64encode(b"x-access-token:" + t).decode())
PY
)"
            fi

            GIT_AUTH=(-c "http.https://github.com/.extraheader=AUTHORIZATION: basic ${AUTH_B64}")

            echo "[INFO] cloning ${REPO_SLUG}@${BASE_BRANCH}"
            git "${GIT_AUTH[@]}" clone --depth=1 --branch "${BASE_BRANCH}" "https://github.com/${REPO_SLUG}.git" repo
            cd repo

            git config user.name  "${GIT_AUTHOR_NAME}"
            git config user.email "${GIT_AUTHOR_EMAIL}"

            git checkout -b "${GITOPS_BRANCH}"

            test -f "${TARGET_FILE}" || (echo "[ERROR] file not found: ${TARGET_FILE}" && exit 1)

            # --- YAML 수정: Deployment 문서 블록 안의 첫 replicas: 만 변경 ---
            # heredoc을 'PY'로 막았기 때문에 쉘변수 확장이 안 됨 => Python에서 env로 읽는 방식이 표준/안전
            export NEW_REPLICAS="${NEW_REPLICAS:-${NEW_REPLICAS}}"
            export NEW_REPLICAS="${NEW_REPLICAS:-${NEW_REPLICAS}}"
            export NEW_REPLICAS="${NEW_REPLICAS:-${NEW_REPLICAS}}"
          '''
          // ↑ 위에 export 라인은 불필요해 보일 수 있는데, 어떤 에이전트 환경에선 params가 환경변수로 안 보이는 경우를 방지하려는 방어 코딩.
          //   다만 Jenkins Declarative에서는 보통 NEW_REPLICAS가 env로 잡혀서 없어도 됩니다.
        }
      }
    }

    stage('Patch / Commit / Push (continued)') {
      steps {
        withCredentials([usernamePassword(
          credentialsId: 'github-app',
          usernameVariable: 'GH_USER_IGNORED',
          passwordVariable: 'GH_TOKEN'
        )]) {
          sh '''
            set -euo pipefail
            cd work/repo

            # params.NEW_REPLICAS는 Declarative에서 보통 환경변수로도 들어옴(없으면 아래에서 Groovy로 넣어도 됨)
            export NEW_REPLICAS="${NEW_REPLICAS:-${NEW_REPLICAS:-}}"
            if [ -z "${NEW_REPLICAS}" ]; then
              # 혹시 NEW_REPLICAS 환경변수가 비어있으면 Jenkins가 NEW_REPLICAS 파라미터를 안 내려준 상황
              # 이 경우를 대비해 아래 한 줄은 Jenkins/Groovy에서 주입하는게 더 확실하지만, 여기서는 안전장치만 둠
              echo "[WARN] NEW_REPLICAS env is empty; this should not happen in normal Declarative builds."
              exit 1
            fi

            if command -v base64 >/dev/null 2>&1; then
              AUTH_B64="$(printf "x-access-token:%s" "${GH_TOKEN}" | base64 | tr -d '\\n')"
            else
              AUTH_B64="$(python3 - <<'PY'
import os, base64
t = os.environ["GH_TOKEN"].encode()
print(base64.b64encode(b"x-access-token:" + t).decode())
PY
)"
            fi
            GIT_AUTH=(-c "http.https://github.com/.extraheader=AUTHORIZATION: basic ${AUTH_B64}")

            python3 - <<'PY'
import os, sys
path = os.environ["TARGET_FILE"]
new_repl = os.environ["NEW_REPLICAS"]

with open(path, "r", encoding="utf-8") as f:
    lines = f.readlines()

out = []
changed = False
in_deploy = False

for line in lines:
    if line.strip() == "kind: Deployment":
        in_deploy = True
    if line.strip() == "---":
        in_deploy = False

    if in_deploy and (not changed) and line.lstrip().startswith("replicas:"):
        indent = line.split("replicas:")[0]
        out.append(f"{indent}replicas: {new_repl}\\n")
        changed = True
    else:
        out.append(line)

if not changed:
    print("[ERROR] replicas line not found in Deployment block", file=sys.stderr)
    sys.exit(1)

with open(path, "w", encoding="utf-8") as f:
    f.writelines(out)

print(f"[OK] updated replicas -> {new_repl} in {path}")
PY

            # 변경이 없으면(이미 원하는 replicas) 커밋/푸시/PR 생성을 하지 않음 (CI 표준 no-op 처리)
            if git diff --quiet; then
              echo "[INFO] No changes detected. replicas already set. Skipping commit/push."
              echo "NO_CHANGE" > ../.jenkins_result
              exit 0
            fi

            git add "${TARGET_FILE}"
            git commit -m "gitops: mediawiki replicas -> ${NEW_REPLICAS} [skip ci]"

            if [ "${DRY_RUN}" = "true" ]; then
              echo "[INFO] DRY_RUN=true. Skipping push."
              echo "DRY_RUN" > ../.jenkins_result
              exit 0
            fi

            # push도 extraheader 인증으로 수행 (URL에 토큰 남기지 않음)
            git "${GIT_AUTH[@]}" push -u origin "${GITOPS_BRANCH}"
            echo "PUSHED" > ../.jenkins_result
          '''
        }
      }
    }

    stage('Create or Reuse PR') {
      when {
        expression {
          // 결과 파일을 보고 PR 생성 여부를 결정 (NO_CHANGE/DRY_RUN이면 PR 생성 안 함)
          return fileExists('work/.jenkins_result') && readFile('work/.jenkins_result').trim() == 'PUSHED'
        }
      }
      steps {
        withCredentials([usernamePassword(
          credentialsId: 'github-app',
          usernameVariable: 'GH_USER_IGNORED',
          passwordVariable: 'GH_TOKEN'
        )]) {
          sh '''
            set -euo pipefail

            OWNER="${REPO_SLUG%/*}"
            API="https://api.github.com/repos/${REPO_SLUG}"
            HEAD="${OWNER}:${GITOPS_BRANCH}"

            # 이미 같은 head 브랜치로 열린 PR이 있으면 재사용(중복 PR 방지)
            EXISTING_JSON="$(curl -fsSL \
              -H "Authorization: Bearer ${GH_TOKEN}" \
              -H "Accept: application/vnd.github+json" \
              "${API}/pulls?state=open&head=${HEAD}")"

            python3 - <<'PY'
import os, json, sys

existing = json.loads(os.environ["EXISTING_JSON"])
if isinstance(existing, list) and len(existing) > 0:
    pr = existing[0]
    url = pr.get("html_url") or pr.get("url") or ""
    print(f"[INFO] Existing PR found: {url}")
    with open("pr_url.txt", "w", encoding="utf-8") as f:
        f.write(url)
    sys.exit(0)

payload = {
  "title": f"gitops: mediawiki replicas -> {os.environ['NEW_REPLICAS']}",
  "head": os.environ["GITOPS_BRANCH"],
  "base": os.environ["BASE_BRANCH"],
  "body": "Automated by Jenkins\\n\\n"
          f"- file: {os.environ['TARGET_FILE']}\\n"
          f"- replicas: {os.environ['NEW_REPLICAS']}\\n"
}

print(json.dumps(payload))
PY
          '''
          // 위 python이 payload JSON을 stdout으로 내보내므로, 아래에서 POST할 때 --data @- 형태로 다시 호출
          sh '''
            set -euo pipefail
            OWNER="${REPO_SLUG%/*}"
            API="https://api.github.com/repos/${REPO_SLUG}"

            # pr_url.txt가 이미 있으면(기존 PR 재사용) 생성 스킵
            if [ -f "pr_url.txt" ]; then
              exit 0
            fi

            PR_JSON="$(python3 - <<'PY'
import os, json
payload = {
  "title": f"gitops: mediawiki replicas -> {os.environ['NEW_REPLICAS']}",
  "head": os.environ["GITOPS_BRANCH"],
  "base": os.environ["BASE_BRANCH"],
  "body": "Automated by Jenkins\\n\\n"
          f"- file: {os.environ['TARGET_FILE']}\\n"
          f"- replicas: {os.environ['NEW_REPLICAS']}\\n"
}
print(json.dumps(payload))
PY
)"
            RESP="$(curl -fsSL -X POST \
              -H "Authorization: Bearer ${GH_TOKEN}" \
              -H "Accept: application/vnd.github+json" \
              "${API}/pulls" \
              -d "${PR_JSON}")"

            python3 - <<'PY'
import json, sys
resp = json.loads(sys.stdin.read())
url = resp.get("html_url") or resp.get("url") or ""
print(f"[INFO] Created PR: {url}")
with open("pr_url.txt", "w", encoding="utf-8") as f:
    f.write(url)
PY
            <<< "${RESP}"
          '''
        }
        script {
          if (fileExists('pr_url.txt')) {
            env.PR_URL = readFile('pr_url.txt').trim()
            currentBuild.description = "${currentBuild.description} PR=${env.PR_URL}"
            echo "PR_URL=${env.PR_URL}"
          }
        }
      }
    }
  }

  post {
    always {
      echo "RESULT: ${currentBuild.currentResult}"
      echo "GITOPS_BRANCH=${env.GITOPS_BRANCH ?: 'n/a'}"
      echo "PR_URL=${env.PR_URL ?: 'n/a'}"
      deleteDir()
    }
  }
}
