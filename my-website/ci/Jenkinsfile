pipeline {
  agent any
  options { timestamps(); disableConcurrentBuilds() }

  environment {
    // === 너 레포 ===
    REPO_SLUG = "lucky-gun/kubernetes"
    BASE_BRANCH = "main"
    
    TARGET_FILE = "my-website/gitops/apps/mediawiki/mediawiki.yaml"

    NEW_REPILCAS = "2"
    // 커밋 작성자
    GIT_AUTHOR_NAME  = "jenkins-gitops-bot"
    GIT_AUTHOR_EMAIL = "jenkins-gitops-bot@local"
  }

 stages {
    stage("Set tag") {
      steps {
        script {
          def sha = sh(returnStdout: true, script: "git rev-parse --short=8 HEAD || echo nosha").trim()
          env.CHANGE_ID = "replicas-${NEW_REPLICAS}-${BUILD_NUMBER}-${sha}"
          env.BRANCH = "gitops-${env.CHANGE_ID}"
          echo "BRANCH=${env.BRANCH}"
        }
      }
    }

    stage("4-A: clone / modify / push (GitHub App token)") {
      steps {
        withCredentials([usernamePassword(
          credentialsId: 'github-app',
          usernameVariable: 'GH_USER',
          passwordVariable: 'GH_TOKEN'
        )]) {
          sh '''
            set -euo pipefail

            rm -rf work && mkdir -p work && cd work

            REPO_URL="https://x-access-token:${GH_TOKEN}@github.com/${REPO_SLUG}.git"
            git clone --depth=1 --branch "${BASE_BRANCH}" "${REPO_URL}" repo
            cd repo

            git config user.name  "${GIT_AUTHOR_NAME}"
            git config user.email "${GIT_AUTHOR_EMAIL}"

            git checkout -b "${BRANCH}"

            test -f "${TARGET_FILE}" || (echo "[ERROR] file not found: ${TARGET_FILE}" && exit 1)

            # Deployment 섹션의 replicas만 바꾸기(단순 sed보다 안전하게 '첫번째 replicas:'만 변경)
            python3 - <<'PY'
import sys
path = "${TARGET_FILE}"
new_repl = "${NEW_REPLICAS}"
with open(path, "r", encoding="utf-8") as f:
    lines = f.readlines()

out = []
changed = False
in_deploy = False

for line in lines:
    # Deployment 문서 시작 감지
    if line.strip() == "kind: Deployment":
        in_deploy = True
    # 다음 문서 시작이면 Deployment 섹션 종료
    if line.strip() == "---":
        in_deploy = False

    if in_deploy and (not changed) and line.lstrip().startswith("replicas:"):
        indent = line.split("replicas:")[0]
        out.append(f"{indent}replicas: {new_repl}\n")
        changed = True
    else:
        out.append(line)

if not changed:
    print("[ERROR] replicas line not found in Deployment block", file=sys.stderr)
    sys.exit(1)

with open(path, "w", encoding="utf-8") as f:
    f.writelines(out)

print(f"[OK] updated replicas -> {new_repl} in {path}")
PY

            git add "${TARGET_FILE}"
            # [skip ci] : Jenkins가 만든 커밋/PR 때문에 멀티브랜치가 루프 도는 것 방지용
            git commit -m "gitops: mediawiki replicas -> ${NEW_REPLICAS} [skip ci]"
            git push -u origin "${BRANCH}"
          '''
        }
      }
    }

    stage("4-B: create PR via GitHub API") {
      steps {
        withCredentials([usernamePassword(
          credentialsId: 'github-app',
          usernameVariable: 'GH_USER',
          passwordVariable: 'GH_TOKEN'
        )]) {
          sh '''
            set -euo pipefail

            PR_JSON=$(cat <<EOF
{
  "title": "gitops: mediawiki replicas -> ${NEW_REPLICAS}",
  "head": "${BRANCH}",
  "base": "${BASE_BRANCH}",
  "body": "Automated by Jenkins\\n\\n- file: ${TARGET_FILE}\\n- replicas: ${NEW_REPLICAS}"
}
EOF
)
            curl -fsSL -X POST \
              -H "Authorization: Bearer ${GH_TOKEN}" \
              -H "Accept: application/vnd.github+json" \
              "https://api.github.com/repos/${REPO_SLUG}/pulls" \
              -d "${PR_JSON}" | cat
          '''
        }
      }
    }
  }
}

