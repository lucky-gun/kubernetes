pipeline {
  agent {
    kubernetes {
      defaultContainer 'tools'
      yaml """
apiVersion: v1
kind: Pod
spec:
  containers:
  - name: tools
    image: alpine:3.20
    command:
    - sh
    - -c
    - |
      set -eux
      apk add --no-cache git curl ca-certificates coreutils yq github-cli openssh-client
      update-ca-certificates
      cat
    tty: true
"""
    }
  }

  options {
    timeout(time: 20, unit: 'MINUTES')
    disableConcurrentBuilds()
    // 멀티브랜치/SCM 자동 체크아웃을 안 믿고 명시적으로 하려면 true 유지
    // 만약 checkout scm 자동으로 이미 잘 되고 있으면 이 옵션을 지워도 됨
    skipDefaultCheckout(true)
  }

  parameters {
    string(name: 'NEW_REPLICAS', defaultValue: '2', description: 'target replicas (ex: 2)')
  }

  environment {
    REPO        = "lucky-gun/kubernetes"
    BASE_BRANCH = "main"
    FILE_PATH   = "my-website/gitops/apps/mediawiki/mediawiki.yaml"

    // ✅ NEW_REPLICAS unset 방지용
    NEW_REPLICAS = "${params.NEW_REPLICAS}"

    // 🔧 여기만 네 Jenkins credentialId로 바꿔줘 (Secret Text)
    GH_TOKEN_CRED_ID = "github-app-token"
  }

  stages {
    stage("Checkout") {
      steps {
        // 같은 repo에서 Jenkinsfile을 읽어오더라도, 작업 디렉토리는 checkout을 명시하는 게 안전함
        checkout scm
      }
    }

    stage("Edit replicas 3 -> NEW_REPLICAS") {
      steps {
        sh '''
          set -euo pipefail
          : "${NEW_REPLICAS:=2}"
          echo "NEW_REPLICAS=$NEW_REPLICAS"

          test -f "${FILE_PATH}"

          # spec.replicas == 3 인 경우에만 NEW_REPLICAS로 변경
          yq -i 'if (has("spec") and .spec.replicas == 3) then .spec.replicas = (env(NEW_REPLICAS) | tonumber) else . end' "${FILE_PATH}"

          git diff -- "${FILE_PATH}" | tee /tmp/diff.txt

          # 실제로 replicas 3 -> 변경이 diff에 있어야만 통과 (헛 PR 방지)
          grep -qE '^-\\s*replicas:\\s*3\\s*$' /tmp/diff.txt
          grep -qE '^\\+\\s*replicas:\\s*' /tmp/diff.txt
        '''
      }
    }

    stage("Commit & Push branch") {
      steps {
        withCredentials([string(credentialsId: "${env.GH_TOKEN_CRED_ID}", variable: "GH_TOKEN")]) {
          sh '''
            set -euo pipefail
            : "${NEW_REPLICAS:=2}"

            BRANCH="chore/scale-mediawiki-${NEW_REPLICAS}-${BUILD_NUMBER}"
            echo "$BRANCH" > /tmp/branch_name.txt

            git checkout -b "$BRANCH"
            git config user.name  "jenkins-bot"
            git config user.email "jenkins-bot@users.noreply.github.com"

            git add "${FILE_PATH}"
            git commit -m "chore(mediawiki): scale replicas to ${NEW_REPLICAS} (pipeline test)"

            # token으로 push
            set +x
            git remote set-url origin "https://x-access-token:${GH_TOKEN}@github.com/${REPO}.git"
            git push -u origin "$BRANCH"
            set -x
          '''
        }
      }
    }

    stage("Create Pull Request") {
      steps {
        withCredentials([string(credentialsId: "${env.GH_TOKEN_CRED_ID}", variable: "GH_TOKEN")]) {
          sh '''
            set -euo pipefail
            BRANCH="$(cat /tmp/branch_name.txt)"

            export GITHUB_TOKEN="${GH_TOKEN}"

            PR_URL="$(gh pr create \
              --repo "${REPO}" \
              --base "${BASE_BRANCH}" \
              --head "$BRANCH" \
              --title "Scale mediawiki replicas: 3 -> ${NEW_REPLICAS} (test)" \
              --body "MVP test: Jenkins creates PR updating ${FILE_PATH} replicas 3->${NEW_REPLICAS}." \
            )"

            echo "$PR_URL" > /tmp/pr_url.txt
            echo "PR created: $PR_URL"
          '''
        }

        script {
          env.PR_URL = sh(script: "cat /tmp/pr_url.txt", returnStdout: true).trim()
        }
      }
    }
  }

  post {
    success {
      echo "RESULT: SUCCESS"
      echo "PR_URL=${env.PR_URL}"
      echo "NEW_REPLICAS=${env.NEW_REPLICAS}"
    }
    failure {
      echo "RESULT: FAILURE"
      echo "NEW_REPLICAS=${env.NEW_REPLICAS}"
    }
  }
}
