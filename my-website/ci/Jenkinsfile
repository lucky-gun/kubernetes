pipeline {
  agent {
    kubernetes {
      defaultContainer 'tools'
      yaml """
apiVersion: v1
kind: Pod
spec:
  containers:
  - name: tools
    image: alpine:3.20
    command: ["sh","-c","apk add --no-cache git curl python3 ca-certificates && update-ca-certificates && cat"]
    tty: true
"""
    }
  }

  options {
    disableConcurrentBuilds()
    skipDefaultCheckout(true)
    timeout(time: 20, unit: 'MINUTES')
  }

  parameters {
    string(name: 'NEW_REPLICAS', defaultValue: '2', description: 'Deployment replicas')
  }

  environment {
    REPO_SLUG   = "lucky-gun/kubernetes"
    BASE_BRANCH = "main"
    TARGET_FILE = "my-website/gitops/apps/mediawiki/mediawiki.yaml"
    GIT_AUTHOR_NAME  = "jenkins-gitops-bot"
    GIT_AUTHOR_EMAIL = "jenkins-gitops-bot@local"
  }

  stages {
    stage('GitOps: patch replicas + PR') {
      steps {
        withCredentials([usernamePassword(
          credentialsId: 'github-app',
          usernameVariable: 'IGNORED',
          passwordVariable: 'GH_TOKEN'
        )]) {
          sh '''
            set -eu
            set +x

            BRANCH="gitops-replicas-${NEW_REPLICAS}-${BUILD_NUMBER}"

            rm -rf work && mkdir -p work && cd work

            AUTH_B64="$(printf 'x-access-token:%s' "${GH_TOKEN}" | base64 | tr -d '\\n')"
            EXTRAHEADER="http.https://github.com/.extraheader=AUTHORIZATION: basic ${AUTH_B64}"

            git -c "${EXTRAHEADER}" clone --depth=1 --branch "${BASE_BRANCH}" "https://github.com/${REPO_SLUG}.git" repo
            cd repo

            git config user.name  "${GIT_AUTHOR_NAME}"
            git config user.email "${GIT_AUTHOR_EMAIL}"
            git checkout -b "${BRANCH}"

            python3 - <<'PY'
import os, sys
path = os.environ["TARGET_FILE"]
new_repl = os.environ["NEW_REPLICAS"]

lines = open(path, encoding="utf-8").readlines()
out, changed, in_deploy = [], False, False

for line in lines:
    if line.strip() == "kind: Deployment":
        in_deploy = True
    if line.strip() == "---":
        in_deploy = False
    if in_deploy and (not changed) and line.lstrip().startswith("replicas:"):
        indent = line.split("replicas:")[0]
        out.append(f"{indent}replicas: {new_repl}\\n")
        changed = True
    else:
        out.append(line)

if not changed:
    print("replicas not found in Deployment", file=sys.stderr)
    sys.exit(1)

open(path, "w", encoding="utf-8").writelines(out)
PY

            git add "${TARGET_FILE}"
            git commit -m "gitops: mediawiki replicas -> ${NEW_REPLICAS} [skip ci]"
            git -c "${EXTRAHEADER}" push -u origin "${BRANCH}"

            PR_JSON="$(python3 - <<'PY'
import os, json
print(json.dumps({
  "title": f"gitops: mediawiki replicas -> {os.environ['NEW_REPLICAS']}",
  "head": os.environ["BRANCH"],
  "base": os.environ["BASE_BRANCH"],
  "body": "Automated by Jenkins"
}))
PY
)"
            curl -fsSL -X POST \
              -H "Authorization: Bearer ${GH_TOKEN}" \
              -H "Accept: application/vnd.github+json" \
              "https://api.github.com/repos/${REPO_SLUG}/pulls" \
              -d "${PR_JSON}"
          '''
        }
      }
    }
  }
}
