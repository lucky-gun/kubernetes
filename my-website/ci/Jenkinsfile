pipeline {
  /*
    ✅ K8s 에이전트에서 "툴이 없는 jnlp 컨테이너"만 잡히는 경우가 많아서,
    tools 컨테이너를 하나 추가해서 git/curl/python3를 확보하는 표준 패턴을 씁니다.
    만약 네 기본 에이전트에 이미 git/curl/python3가 다 있다면,
    agent 블록을 `agent any`로 바꿔도 됩니다.
  */
  agent {
    kubernetes {
      defaultContainer 'tools'
      yaml """
apiVersion: v1
kind: Pod
spec:
  containers:
  - name: tools
    image: alpine:3.20
    command:
    - sh
    - -c
    - |
      apk add --no-cache git curl python3 coreutils ca-certificates && update-ca-certificates && cat
    tty: true
"""
    }
  }

  options {
    disableConcurrentBuilds()
    skipDefaultCheckout(true)
    timeout(time: 30, unit: 'MINUTES')
    buildDiscarder(logRotator(numToKeepStr: '30'))
  }

  parameters {
    string(name: 'NEW_REPLICAS', defaultValue: '2', description: 'mediawiki Deployment replicas 값 (0 이상의 정수)')
    booleanParam(name: 'DRY_RUN', defaultValue: false, description: 'true면 커밋/푸시/PR 생성 없이 변경만 검증')
  }

  environment {
    REPO_SLUG   = "lucky-gun/kubernetes"
    BASE_BRANCH = "main"
    TARGET_FILE = "my-website/gitops/apps/mediawiki/mediawiki.yaml"

    GIT_AUTHOR_NAME  = "jenkins-gitops-bot"
    GIT_AUTHOR_EMAIL = "jenkins-gitops-bot@local"
  }

  stages {

    stage('Guard / Validate Inputs') {
      steps {
        script {
          // 루프 방지: gitops-* 브랜치에서 이 파이프라인이 다시 돌면 종료
          if (env.BRANCH_NAME?.startsWith('gitops-')) {
            currentBuild.description = "Skipped (loop guard)"
            error("Skipping build on gitops-* branch to prevent CI loops.")
          }

          def r = params.NEW_REPLICAS?.trim()
          if (!(r ==~ /^\d+$/) || (r.toInteger() < 0)) {
            error("NEW_REPLICAS must be a non-negative integer. got='${params.NEW_REPLICAS}'")
          }

          // params -> env 로 명시 변환 (sh/python에서 확실히 쓰게)
          env.NEW_REPLICAS = r
          env.DRY_RUN = params.DRY_RUN.toString()

          echo "NEW_REPLICAS=${env.NEW_REPLICAS}, DRY_RUN=${env.DRY_RUN}"
        }
      }
    }

    stage('Checkout (pipeline repo) for trace') {
      steps {
        dir('pipeline-src') {
          checkout scm
          script {
            env.PIPELINE_SHA = sh(returnStdout: true, script: "git rev-parse --short=8 HEAD || echo nosha").trim()
            echo "PIPELINE_SHA=${env.PIPELINE_SHA}"
          }
        }
      }
    }

    stage('Prepare GitOps branch name') {
      steps {
        script {
          // CHANGE_ID 같은 예약 변수 덮어쓰기 금지
          env.GITOPS_ID = "replicas-${env.NEW_REPLICAS}-${env.BUILD_NUMBER}-${env.PIPELINE_SHA}"
          env.GITOPS_BRANCH = "gitops-${env.GITOPS_ID}"
          currentBuild.description = "replicas=${env.NEW_REPLICAS} branch=${env.GITOPS_BRANCH}"
          echo "GITOPS_BRANCH=${env.GITOPS_BRANCH}"
        }
      }
    }

    stage('Clone / Patch / Commit / Push') {
      steps {
        withCredentials([usernamePassword(
          credentialsId: 'github-app',
          usernameVariable: 'GH_USER_IGNORED',
          passwordVariable: 'GH_TOKEN'
        )]) {
          sh '''
            set -eu
            # pipefail 지원 셸이면 켜고, 아니면 무시
            (set -o pipefail >/dev/null 2>&1) && set -o pipefail || true

            # Jenkins sh는 기본적으로 -x로 로그에 명령을 찍을 수 있음 -> 민감값 보호
            set +x

            rm -rf work
            mkdir -p work
            cd work

            # Basic auth header (x-access-token:token -> base64)
            AUTH_B64="$(printf 'x-access-token:%s' "${GH_TOKEN}" | base64 | tr -d '\\n')"
            EXTRAHEADER="http.https://github.com/.extraheader=AUTHORIZATION: basic ${AUTH_B64}"

            echo "[INFO] cloning ${REPO_SLUG}@${BASE_BRANCH}"
            git -c "${EXTRAHEADER}" clone --depth=1 --branch "${BASE_BRANCH}" "https://github.com/${REPO_SLUG}.git" repo
            cd repo

            git config user.name  "${GIT_AUTHOR_NAME}"
            git config user.email "${GIT_AUTHOR_EMAIL}"

            git checkout -b "${GITOPS_BRANCH}"

            test -f "${TARGET_FILE}" || (echo "[ERROR] file not found: ${TARGET_FILE}" && exit 1)

            # YAML 수정: kind: Deployment 문서 블록 안의 첫 replicas: 만 변경
            python3 - <<'PY'
import os, sys

path = os.environ["TARGET_FILE"]
new_repl = os.environ["NEW_REPLICAS"]

with open(path, "r", encoding="utf-8") as f:
    lines = f.readlines()

out = []
changed = False
in_deploy = False

for line in lines:
    if line.strip() == "kind: Deployment":
        in_deploy = True
    if line.strip() == "---":
        in_deploy = False

    if in_deploy and (not changed) and line.lstrip().startswith("replicas:"):
        indent = line.split("replicas:")[0]
        out.append(f"{indent}replicas: {new_repl}\\n")
        changed = True
    else:
        out.append(line)

if not changed:
    print("[ERROR] replicas line not found in Deployment block", file=sys.stderr)
    sys.exit(1)

with open(path, "w", encoding="utf-8") as f:
    f.writelines(out)

print(f"[OK] updated replicas -> {new_repl} in {path}")
PY

            # no-op: 이미 값이 같으면 종료(커밋/푸시/PR 생성 안 함)
            if git diff --quiet; then
              echo "[INFO] No changes detected. replicas already set. Skipping commit/push/PR."
              echo "NO_CHANGE" > ../.jenkins_result
              exit 0
            fi

            git add "${TARGET_FILE}"
            git commit -m "gitops: mediawiki replicas -> ${NEW_REPLICAS} [skip ci]"

            if [ "${DRY_RUN}" = "true" ]; then
              echo "[INFO] DRY_RUN=true. Skipping push."
              echo "DRY_RUN" > ../.jenkins_result
              exit 0
            fi

            echo "[INFO] pushing branch ${GITOPS_BRANCH}"
            git -c "${EXTRAHEADER}" push -u origin "${GITOPS_BRANCH}"
            echo "PUSHED" > ../.jenkins_result
          '''
        }
      }
    }

    stage('Create or Reuse PR') {
      when {
        expression {
          return fileExists('work/.jenkins_result') && readFile('work/.jenkins_result').trim() == 'PUSHED'
        }
      }
      steps {
        withCredentials([usernamePassword(
          credentialsId: 'github-app',
          usernameVariable: 'GH_USER_IGNORED',
          passwordVariable: 'GH_TOKEN'
        )]) {
          sh '''
            set -eu
            (set -o pipefail >/dev/null 2>&1) && set -o pipefail || true
            set +x

            cd work

            OWNER="${REPO_SLUG%/*}"
            API="https://api.github.com/repos/${REPO_SLUG}"
            HEAD="${OWNER}:${GITOPS_BRANCH}"

            echo "[INFO] checking existing PR (head=${HEAD})"

            # 기존 PR 있으면 재사용
            curl -fsSL \
              -H "Authorization: Bearer ${GH_TOKEN}" \
              -H "Accept: application/vnd.github+json" \
              "${API}/pulls?state=open&head=${HEAD}" \
            | python3 - <<'PY'
import json, sys
existing = json.load(sys.stdin)
if isinstance(existing, list) and existing:
    pr = existing[0]
    url = pr.get("html_url") or pr.get("url") or ""
    print(f"[INFO] Existing PR found: {url}")
    with open("pr_url.txt", "w", encoding="utf-8") as f:
        f.write(url)
PY

            if [ -f "pr_url.txt" ]; then
              exit 0
            fi

            echo "[INFO] creating PR"

            PR_JSON="$(python3 - <<'PY'
import os, json
payload = {
  "title": f"gitops: mediawiki replicas -> {os.environ['NEW_REPLICAS']}",
  "head": os.environ["GITOPS_BRANCH"],
  "base": os.environ["BASE_BRANCH"],
  "body": "Automated by Jenkins\\n\\n"
          f"- file: {os.environ['TARGET_FILE']}\\n"
          f"- replicas: {os.environ['NEW_REPLICAS']}\\n"
}
print(json.dumps(payload))
PY
)"

            curl -fsSL -X POST \
              -H "Authorization: Bearer ${GH_TOKEN}" \
              -H "Accept: application/vnd.github+json" \
              "${API}/pulls" \
              -d "${PR_JSON}" \
            | python3 - <<'PY'
import json, sys
resp = json.load(sys.stdin)
url = resp.get("html_url") or resp.get("url") or ""
print(f"[INFO] Created PR: {url}")
with open("pr_url.txt", "w", encoding="utf-8") as f:
    f.write(url)
PY
          '''
        }

        script {
          if (fileExists('work/pr_url.txt')) {
            env.PR_URL = readFile('work/pr_url.txt').trim()
            currentBuild.description = "${currentBuild.description} PR=${env.PR_URL}"
            echo "PR_URL=${env.PR_URL}"
          }
        }
      }
    }
  }

  post {
    always {
      echo "RESULT: ${currentBuild.currentResult}"
      echo "GITOPS_BRANCH=${env.GITOPS_BRANCH ?: 'n/a'}"
      echo "PR_URL=${env.PR_URL ?: 'n/a'}"
      deleteDir()
    }
  }
}
