pipeline {
  agent any

  parameters {
    string(name: 'NEW_TAG', defaultValue: 'myblog-beta', description: 'mediawiki 이미지 태그')
    string(name: 'NEW_REPLICAS', defaultValue: '3', description: 'mediawiki replicas')
  }

  environment {
    FILE_PATH    = 'my-website/gitops/apps/mediawiki/mediawiki.yaml'
    SKIP_FLAG    = '[skip-gitops]'
    PUSH_CRED_ID = 'github_pat_push'
    BASE_BRANCH  = 'main'
    REPO_OWNER   = 'lucky-gun'
    REPO_NAME    = 'kubernetes'
  }

  stages {
    stage('Checkout') {
      steps { checkout scm }
    }

    stage('Guard (avoid loop)') {
      steps {
        script {
          def msg = sh(script: "git log -1 --pretty=%B", returnStdout: true).trim()
          if (msg.contains(env.SKIP_FLAG)) {
            env.SKIP = 'true'
            echo "Skip due to ${env.SKIP_FLAG}"
          }
        }
      }
    }

    stage('Edit YAML') {
      when { expression { env.SKIP != 'true' } }
      steps {
        sh '''
          set -e
          set -o pipefail

          # 파라미터가 비면(Branch indexing 등) 그냥 스킵 (파일 망가지는 것 방지)
          if [ -z "${NEW_TAG:-}" ] || [ -z "${NEW_REPLICAS:-}" ]; then
            echo "Missing params -> skip (NEW_TAG/NEW_REPLICAS)"
            exit 0
          fi

          test -f "${FILE_PATH}" || (echo "ERROR: not found ${FILE_PATH}" && exit 1)

          sed -i -E "0,/^[[:space:]]*replicas:[[:space:]]*[0-9]+[[:space:]]*$/s//  replicas: ${NEW_REPLICAS}/" "${FILE_PATH}"
          sed -i -E "s|(^[[:space:]]*image:[[:space:]]*luckygun/mediawiki:).*|\\1${NEW_TAG}|g" "${FILE_PATH}"

          # ✅ 유지: 변경점 확인
          git diff -- "${FILE_PATH}" || true
        '''
      }
    }

    stage('Create PR') {
      when { expression { env.SKIP != 'true' } }
      steps {
        withCredentials([string(credentialsId: "${env.PUSH_CRED_ID}", variable: 'GITHUB_TOKEN')]) {
          sh '''
            set -e
            set -o pipefail

            if [ -z "${NEW_TAG:-}" ] || [ -z "${NEW_REPLICAS:-}" ]; then
              echo "Missing params -> skip (NEW_TAG/NEW_REPLICAS)"
              exit 0
            fi

            # 변경 없으면 종료
            if ! git status --porcelain | grep -q .; then
              echo "No changes."
              exit 0
            fi

            git config user.name "jenkins-bot"
            git config user.email "jenkins-bot@local"

            BASE_SHA="$(git rev-parse --short HEAD)"
            BUILD_NO="${BUILD_NUMBER:-indexing}"

            BR="gitops/mediawiki-${NEW_TAG}-r${NEW_REPLICAS}-$(date +%Y%m%d-%H%M%S)"
            echo "BRANCH=${BR}"

            git checkout -b "$BR"
            git add "${FILE_PATH}"
            git commit -m "gitops: mediawiki replicas=${NEW_REPLICAS}, tag=${NEW_TAG} ${SKIP_FLAG}"

            git remote set-url origin "https://x-access-token:${GITHUB_TOKEN}@github.com/${REPO_OWNER}/${REPO_NAME}.git"
            git push -u origin "$BR"

            TITLE="gitops: mediawiki tag=${NEW_TAG}, replicas=${NEW_REPLICAS} (build #${BUILD_NO}, base ${BASE_SHA})"
            BODY="Automated change by Jenkins.\\n\\n- file: ${FILE_PATH}\\n- tag: ${NEW_TAG}\\n- replicas: ${NEW_REPLICAS}\\n- base_sha: ${BASE_SHA}\\n- build: ${BUILD_NO}"

            cat > payload.json <<EOF
{
  "title": "${TITLE}",
  "head": "${BR}",
  "base": "${BASE_BRANCH}",
  "body": "${BODY}"
}
EOF

            HTTP_CODE="$(curl -sS -o pr.json -w "%{http_code}" -X POST \
              -H "Authorization: Bearer ${GITHUB_TOKEN}" \
              -H "Accept: application/vnd.github+json" \
              "https://api.github.com/repos/${REPO_OWNER}/${REPO_NAME}/pulls" \
              -d @payload.json)"

            echo "HTTP_CODE=${HTTP_CODE}"

            if [ "${HTTP_CODE}" = "201" ]; then
              PR_URL="$(grep -m 1 -oE '"html_url"[[:space:]]*:[[:space:]]*"[^"]+"' pr.json | sed -E 's/.*"([^"]+)".*/\\1/')"
              echo "PR_URL=${PR_URL}"
              exit 0
            fi

            if [ "${HTTP_CODE}" = "422" ]; then
              echo "PR already exists (422)."
              curl -sS -o pr_list.json \
                -H "Authorization: Bearer ${GITHUB_TOKEN}" \
                -H "Accept: application/vnd.github+json" \
                "https://api.github.com/repos/${REPO_OWNER}/${REPO_NAME}/pulls?state=open&head=${REPO_OWNER}:${BR}&base=${BASE_BRANCH}"

              PR_URL="$(grep -m 1 -oE '"html_url"[[:space:]]*:[[:space:]]*"[^"]+"' pr_list.json | sed -E 's/.*"([^"]+)".*/\\1/' || true)"
              echo "PR_URL=${PR_URL:-not_found}"
              exit 0
            fi

            echo "ERROR: PR creation failed with HTTP ${HTTP_CODE}"
            # ✅ 유지: 실패 시 원인 분석용
            cat pr.json
            exit 1
          '''
        }
      }
    }
  }
}
