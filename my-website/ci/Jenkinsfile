pipeline {
  agent any

  // 빌드 때 입력 가능 (인덱싱/자동 실행에서도 안 깨지게 아래에서 기본값 처리함)
  parameters {
    string(name: 'NEW_TAG', defaultValue: 'myblog-beta', description: 'mediawiki 이미지 태그')
    string(name: 'NEW_REPLICAS', defaultValue: '3', description: 'mediawiki replicas')
  }

  environment {
    FILE_PATH    = 'my-website/gitops/apps/mediawiki/mediawiki.yaml'
    SKIP_FLAG    = '[skip-gitops]'
    PUSH_CRED_ID = 'github_pat_push'  // Secret text(PAT)
    BASE_BRANCH  = 'main'
    REPO_OWNER   = 'lucky-gun'
    REPO_NAME    = 'kubernetes'

    // ✅ Branch indexing 등에서 params가 비어도 기본값으로 안전하게 세팅
    EFFECTIVE_TAG      = "${params.NEW_TAG ?: 'myblog-beta'}"
    EFFECTIVE_REPLICAS = "${params.NEW_REPLICAS ?: '3'}"
  }

  stages {
    stage('Checkout') {
      steps {
        checkout scm
      }
    }

    stage('Guard (avoid loop)') {
      steps {
        script {
          def msg = sh(script: "git log -1 --pretty=%B", returnStdout: true).trim()
          if (msg.contains(env.SKIP_FLAG)) {
            env.SKIP = 'true'
            echo "Detected ${env.SKIP_FLAG} in last commit message. Skipping to avoid loop."
          }
        }
      }
    }

    stage('Edit YAML') {
      when { expression { env.SKIP != 'true' } }
      steps {
        sh '''
          set -euo pipefail

          # ✅ 2중 안전장치: 인덱싱/환경에서 값이 비어도 절대 안 죽게
          : "${EFFECTIVE_TAG:=myblog-beta}"
          : "${EFFECTIVE_REPLICAS:=3}"

          test -f "${FILE_PATH}" || (echo "ERROR: not found ${FILE_PATH}" && exit 1)

          echo "=== Before (grep) ==="
          grep -nE "replicas:|image:[[:space:]]*luckygun/mediawiki:" "${FILE_PATH}" || true

          # replicas 첫 매칭 1개만 변경
          sed -i -E "0,/^[[:space:]]*replicas:[[:space:]]*[0-9]+[[:space:]]*$/s//  replicas: ${EFFECTIVE_REPLICAS}/" "${FILE_PATH}"

          # image 태그 변경
          sed -i -E "s|(^[[:space:]]*image:[[:space:]]*luckygun/mediawiki:).*|\\1${EFFECTIVE_TAG}|g" "${FILE_PATH}"

          echo "=== After (grep) ==="
          grep -nE "replicas:|image:[[:space:]]*luckygun/mediawiki:" "${FILE_PATH}" || true

          echo "=== Diff ==="
          git diff -- "${FILE_PATH}" || true
        '''
      }
    }

    stage('Create PR') {
      when { expression { env.SKIP != 'true' } }
      steps {
        withCredentials([string(credentialsId: "${env.PUSH_CRED_ID}", variable: 'GITHUB_TOKEN')]) {
          sh '''
            set -euo pipefail

            : "${EFFECTIVE_TAG:=myblog-beta}"
            : "${EFFECTIVE_REPLICAS:=3}"

            # 변경 없으면 종료
            if ! git status --porcelain | grep -q .; then
              echo "No changes."
              exit 0
            fi

            git config user.name "jenkins-bot"
            git config user.email "jenkins-bot@local"

            BASE_SHA="$(git rev-parse --short HEAD)"
            BUILD_NO="${BUILD_NUMBER:-indexing}"

            BR="gitops/mediawiki-${EFFECTIVE_TAG}-r${EFFECTIVE_REPLICAS}-$(date +%Y%m%d-%H%M%S)"
            echo "BRANCH: ${BR}"
            echo "BASE_SHA: ${BASE_SHA}"
            echo "BUILD_NO: ${BUILD_NO}"

            git checkout -b "$BR"
            git add "${FILE_PATH}"
            git commit -m "gitops: mediawiki replicas=${EFFECTIVE_REPLICAS}, tag=${EFFECTIVE_TAG} ${SKIP_FLAG}"

            # token으로 push
            git remote set-url origin "https://x-access-token:${GITHUB_TOKEN}@github.com/${REPO_OWNER}/${REPO_NAME}.git"
            git push -u origin "$BR"

            TITLE="gitops: mediawiki tag=${EFFECTIVE_TAG}, replicas=${EFFECTIVE_REPLICAS} (build #${BUILD_NO}, base ${BASE_SHA})"
            BODY="Automated change by Jenkins.\\n\\n- file: ${FILE_PATH}\\n- tag: ${EFFECTIVE_TAG}\\n- replicas: ${EFFECTIVE_REPLICAS}\\n- base_sha: ${BASE_SHA}\\n- build: ${BUILD_NO}"

            cat > payload.json <<EOF
{
  "title": "${TITLE}",
  "head": "${BR}",
  "base": "${BASE_BRANCH}",
  "body": "${BODY}"
}
EOF

            echo "=== payload.json ==="
            cat payload.json

            echo "=== Creating PR ==="
            HTTP_CODE="$(curl -sS -o pr.json -w "%{http_code}" -X POST \
              -H "Authorization: Bearer ${GITHUB_TOKEN}" \
              -H "Accept: application/vnd.github+json" \
              "https://api.github.com/repos/${REPO_OWNER}/${REPO_NAME}/pulls" \
              -d @payload.json)"

            echo "HTTP_CODE=${HTTP_CODE}"
            cat pr.json

            if [ "${HTTP_CODE}" = "201" ]; then
              echo "=== PR url ==="
              # PR 응답엔 html_url이 여러 개 들어가니 첫 번째(=PR)만 출력
              grep -m 1 -oE '"html_url"[[:space:]]*:[[:space:]]*"[^"]+"' pr.json || true
              exit 0
            fi

            if [ "${HTTP_CODE}" = "422" ]; then
              echo "PR already exists (422). Trying to find existing PR url..."

              curl -sS -o pr_list.json \
                -H "Authorization: Bearer ${GITHUB_TOKEN}" \
                -H "Accept: application/vnd.github+json" \
                "https://api.github.com/repos/${REPO_OWNER}/${REPO_NAME}/pulls?state=open&head=${REPO_OWNER}:${BR}&base=${BASE_BRANCH}"

              echo "=== Existing PR url (if any) ==="
              grep -m 1 -oE '"html_url"[[:space:]]*:[[:space:]]*"[^"]+"' pr_list.json || true

              # 422는 실패로 보지 않음
              exit 0
            fi

            echo "ERROR: PR creation failed with HTTP ${HTTP_CODE}"
            exit 1
          '''
        }
      }
    }
  }
}
