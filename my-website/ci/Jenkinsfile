pipeline {
  agent {
    kubernetes {
      defaultContainer 'tools'
      yaml """
apiVersion: v1
kind: Pod
spec:
  containers:
  - name: tools
    image: alpine:3.20
    command: ["sh","-c","apk add --no-cache git curl python3 ca-certificates coreutils && update-ca-certificates && cat"]
    tty: true
"""
    }
  }

  options {
    disableConcurrentBuilds()
    skipDefaultCheckout(true)
    timeout(time: 20, unit: 'MINUTES')
  }

  parameters {
    string(name: 'NEW_REPLICAS', defaultValue: '2', description: 'Deployment replicas (0 이상의 정수)')
  }

  environment {
    REPO_SLUG   = "lucky-gun/kubernetes"
    BASE_BRANCH = "main"
    TARGET_FILE = "my-website/gitops/apps/mediawiki/mediawiki.yaml"

    GIT_AUTHOR_NAME  = "jenkins-gitops-bot"
    GIT_AUTHOR_EMAIL = "jenkins-gitops-bot@local"
  }

  stages {
    stage('GitOps: replicas PR') {
      steps {
        withCredentials([usernamePassword(
          credentialsId: 'github-app',
          usernameVariable: 'IGNORED',
          passwordVariable: 'GH_TOKEN'
        )]) {
          sh '''
            set -eu
            (set -o pipefail >/dev/null 2>&1) && set -o pipefail || true
            set +x  # 토큰 관련 내용 로그 방지

            # 간단 검증
            case "${NEW_REPLICAS}" in
              ''|*[!0-9]*) echo "[ERROR] NEW_REPLICAS must be integer"; exit 1 ;;
            esac

            BRANCH="gitops-replicas-${NEW_REPLICAS}-${BUILD_NUMBER}"
            OWNER="${REPO_SLUG%/*}"
            API="https://api.github.com/repos/${REPO_SLUG}"
            HEAD="${OWNER}:${BRANCH}"

            rm -rf work && mkdir -p work && cd work

            # git 인증: URL에 토큰 박지 않고 extraheader로 처리
            AUTH_B64="$(printf 'x-access-token:%s' "${GH_TOKEN}" | base64 | tr -d '\\n')"
            EXTRAHEADER="http.https://github.com/.extraheader=AUTHORIZATION: basic ${AUTH_B64}"

            git -c "${EXTRAHEADER}" clone --depth=1 --branch "${BASE_BRANCH}" "https://github.com/${REPO_SLUG}.git" repo
            cd repo

            git config user.name  "${GIT_AUTHOR_NAME}"
            git config user.email "${GIT_AUTHOR_EMAIL}"
            git checkout -b "${BRANCH}"

            test -f "${TARGET_FILE}" || (echo "[ERROR] file not found: ${TARGET_FILE}" && exit 1)

            # Deployment 블록 내 첫 replicas: 만 변경
            python3 - <<'PY'
import os, sys
path = os.environ["TARGET_FILE"]
new_repl = os.environ["NEW_REPLICAS"]

lines = open(path, encoding="utf-8").readlines()
out, changed, in_deploy = [], False, False

for line in lines:
    if line.strip() == "kind: Deployment":
        in_deploy = True
    if line.strip() == "---":
        in_deploy = False

    if in_deploy and (not changed) and line.lstrip().startswith("replicas:"):
        indent = line.split("replicas:")[0]
        out.append(f"{indent}replicas: {new_repl}\\n")
        changed = True
    else:
        out.append(line)

if not changed:
    print("[ERROR] replicas not found in Deployment block", file=sys.stderr)
    sys.exit(1)

open(path, "w", encoding="utf-8").writelines(out)
print(f"[OK] replicas -> {new_repl}")
PY

            # 변경 없으면 종료(브랜치/PR 안 만들게 하고 싶으면 여기서 exit 0)
            if git diff --quiet; then
              echo "[INFO] No change. Already desired replicas."
              exit 0
            fi

            git add "${TARGET_FILE}"
            git commit -m "gitops: mediawiki replicas -> ${NEW_REPLICAS} [skip ci]"
            git -c "${EXTRAHEADER}" push -u origin "${BRANCH}"

            # PR 생성 (422면 이미 PR 존재 가능 → 조회해서 URL 출력)
            PR_JSON="$(python3 - <<'PY'
import os, json
print(json.dumps({
  "title": f"gitops: mediawiki replicas -> {os.environ['NEW_REPLICAS']}",
  "head": os.environ["BRANCH"],
  "base": os.environ["BASE_BRANCH"],
  "body": f"Automated by Jenkins\\n- file: {os.environ['TARGET_FILE']}\\n- replicas: {os.environ['NEW_REPLICAS']}"
}))
PY
)"
            STATUS="$(curl -sS -o pr_create.json -w "%{http_code}" -X POST \
              -H "Authorization: Bearer ${GH_TOKEN}" \
              -H "Accept: application/vnd.github+json" \
              "${API}/pulls" \
              -d "${PR_JSON}" || echo "000")"

            if [ "${STATUS}" = "201" ] || [ "${STATUS}" = "200" ]; then
              python3 - <<'PY'
import json
resp = json.load(open("pr_create.json", encoding="utf-8"))
print("[OK] PR:", resp.get("html_url",""))
PY
              exit 0
            fi

            if [ "${STATUS}" = "422" ]; then
              # 같은 head 브랜치로 PR이 이미 있을 수 있음 → 조회해서 URL 출력
              STATUS2="$(curl -sS -o pr_list.json -w "%{http_code}" -G \
                -H "Authorization: Bearer ${GH_TOKEN}" \
                -H "Accept: application/vnd.github+json" \
                --data-urlencode "state=open" \
                --data-urlencode "head=${HEAD}" \
                "${API}/pulls" || echo "000")"

              if [ "${STATUS2}" -ge 200 ] && [ "${STATUS2}" -lt 300 ]; then
                python3 - <<'PY'
import json
data = json.load(open("pr_list.json", encoding="utf-8"))
url = data[0].get("html_url","") if isinstance(data, list) and data else ""
print("[OK] Existing PR:", url)
PY
                exit 0
              fi
            fi

            echo "[ERROR] PR create failed. status=${STATUS}"
            cat pr_create.json || true
            exit 1
          '''
        }
      }
    }
  }

  post {
    always {
      echo "RESULT: ${currentBuild.currentResult}"
      echo "BRANCH=${env.BRANCH_NAME ?: 'n/a'}"
      // deleteDir()는 K8s 컨테이너 권한 꼬임 때문에 일부러 안 씀
    }
  }
}
