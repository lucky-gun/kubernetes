pipeline {
  agent {
    kubernetes {
      defaultContainer 'tools'
      yaml """
apiVersion: v1
kind: Pod
spec:
  containers:
  - name: tools
    image: alpine:3.20
    command:
    - sh
    - -c
    - |
      set -eux
      apk add --no-cache \
        git curl ca-certificates coreutils openssh-client \
        python3 py3-pyyaml \
        github-cli
      update-ca-certificates
      cat
    tty: true
"""
    }
  }

  options {
    timeout(time: 20, unit: 'MINUTES')
    disableConcurrentBuilds()
    skipDefaultCheckout(true)
  }

  parameters {
    string(name: 'NEW_REPLICAS', defaultValue: '2', description: 'target replicas (ex: 2)')
  }

  environment {
    REPO        = "lucky-gun/kubernetes"
    BASE_BRANCH = "main"
    FILE_PATH   = "my-website/gitops/apps/mediawiki/mediawiki.yaml"

    NEW_REPLICAS = "${params.NEW_REPLICAS}"

    // 🔧 여기를 네 Jenkins Secret Text credentialId로 변경
    GH_TOKEN_CRED_ID = "github-app-token"
  }

  stages {
    stage("Checkout") {
      steps {
        container('tools') {
          checkout scm
        }
      }
    }

    stage("Edit replicas 3 -> NEW_REPLICAS") {
      steps {
        container('tools') {
          sh '''
            set -euo pipefail
            : "${NEW_REPLICAS:=2}"
            echo "NEW_REPLICAS=$NEW_REPLICAS"
            test -f "${FILE_PATH}"

            python3 - <<'PY'
import os, sys, yaml

path = os.environ["FILE_PATH"]
new_repl = int(os.environ.get("NEW_REPLICAS", "2"))

with open(path, "r", encoding="utf-8") as f:
    docs = list(yaml.safe_load_all(f))

changed = False
for d in docs:
    if isinstance(d, dict):
        spec = d.get("spec")
        if isinstance(spec, dict) and spec.get("replicas") == 3:
            spec["replicas"] = new_repl
            changed = True

if not changed:
    print("No change made (spec.replicas was not 3). Failing to avoid empty PR.")
    sys.exit(2)

with open(path, "w", encoding="utf-8") as f:
    yaml.safe_dump_all(docs, f, sort_keys=False)

print(f"Updated replicas: 3 -> {new_repl}")
PY

            git diff -- "${FILE_PATH}" | tee /tmp/diff.txt
            test -s /tmp/diff.txt
          '''
        }
      }
    }

    stage("Commit & Push branch") {
      steps {
        container('tools') {
          withCredentials([string(credentialsId: "${env.GH_TOKEN_CRED_ID}", variable: "GH_TOKEN")]) {
            sh '''
              set -euo pipefail
              : "${NEW_REPLICAS:=2}"

              BRANCH="chore/scale-mediawiki-${NEW_REPLICAS}-${BUILD_NUMBER}"
              echo "$BRANCH" > /tmp/branch_name.txt

              git checkout -b "$BRANCH"
              git config user.name  "jenkins-bot"
              git config user.email "jenkins-bot@users.noreply.github.com"

              git add "${FILE_PATH}"
              git commit -m "chore(mediawiki): scale replicas to ${NEW_REPLICAS} (pipeline test)"

              # token으로 push
              set +x
              git remote set-url origin "https://x-access-token:${GH_TOKEN}@github.com/${REPO}.git"
              git push -u origin "$BRANCH"
              set -x
            '''
          }
        }
      }
    }

    stage("Create Pull Request") {
      steps {
        container('tools') {
          withCredentials([string(credentialsId: "${env.GH_TOKEN_CRED_ID}", variable: "GH_TOKEN")]) {
            sh '''
              set -euo pipefail
              BRANCH="$(cat /tmp/branch_name.txt)"

              export GITHUB_TOKEN="${GH_TOKEN}"

              PR_URL="$(gh pr create \
                --repo "${REPO}" \
                --base "${BASE_BRANCH}" \
                --head "$BRANCH" \
                --title "Scale mediawiki replicas: 3 -> ${NEW_REPLICAS} (test)" \
                --body "MVP test: Jenkins creates PR updating ${FILE_PATH} replicas 3->${NEW_REPLICAS}." \
              )"

              echo "$PR_URL" > /tmp/pr_url.txt
              echo "PR created: $PR_URL"
            '''
          }
        }

        script {
          env.PR_URL = sh(script: "cat /tmp/pr_url.txt", returnStdout: true).trim()
        }
      }
    }
  }

  post {
    success {
      echo "RESULT: SUCCESS"
      echo "PR_URL=${env.PR_URL}"
      echo "NEW_REPLICAS=${env.NEW_REPLICAS}"
    }
    failure {
      echo "RESULT: FAILURE"
      echo "NEW_REPLICAS=${env.NEW_REPLICAS}"
    }
  }
}
