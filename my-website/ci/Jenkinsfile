pipeline {
  agent any

  environment {
    FILE_PATH    = 'my-website/gitops/apps/mediawiki/mediawiki.yaml'
    NEW_REPLICAS = '3'
    NEW_TAG      = 'myblog-beta'
    SKIP_FLAG    = '[skip-gitops]'
    PUSH_CRED_ID = 'github_pat_push' // 지금 쓰는 PAT (PR 권한도 있어야 함)
    BASE_BRANCH  = 'main'
  }

  stages {
    stage('Checkout') {
      steps { checkout scm }
    }

    stage('Edit YAML') {
      steps {
        sh '''
          set -euo pipefail

          test -f "${FILE_PATH}" || (echo "ERROR: not found ${FILE_PATH}" && exit 1)

          sed -i -E "0,/^[[:space:]]*replicas:[[:space:]]*[0-9]+[[:space:]]*$/s//  replicas: ${NEW_REPLICAS}/" "${FILE_PATH}"
          sed -i -E "s|(^[[:space:]]*image:[[:space:]]*luckygun/mediawiki:).*|\\1${NEW_TAG}|g" "${FILE_PATH}"

          git diff -- "${FILE_PATH}" || true
        '''
      }
    }
    
stage('Create PR') {
  steps {
    withCredentials([string(credentialsId: "${env.PUSH_CRED_ID}", variable: 'GITHUB_TOKEN')]) {
      sh '''
        set -euo pipefail

        if ! git status --porcelain | grep -q .; then
          echo "No changes."
          exit 0
        fi

        git config user.name "jenkins-bot"
        git config user.email "jenkins-bot@local"

        BR="gitops/mediawiki-${NEW_TAG}-r${NEW_REPLICAS}-$(date +%Y%m%d-%H%M%S)"
        git checkout -b "$BR"

        git add "${FILE_PATH}"
        git commit -m "gitops: mediawiki replicas=${NEW_REPLICAS}, tag=${NEW_TAG} ${SKIP_FLAG}"

        git remote set-url origin "https://x-access-token:${GITHUB_TOKEN}@github.com/lucky-gun/kubernetes.git"
        git push -u origin "$BR"

        TITLE="gitops: mediawiki tag=${NEW_TAG}, replicas=${NEW_REPLICAS}"
        BODY="Automated change by Jenkins.\\n\\n- file: ${FILE_PATH}\\n- tag: ${NEW_TAG}\\n- replicas: ${NEW_REPLICAS}"

        cat > payload.json <<EOF
{
  "title": "${TITLE}",
  "head": "${BR}",
  "base": "${BASE_BRANCH}",
  "body": "${BODY}"
}
EOF

        echo "=== payload.json ==="
        cat payload.json

        echo "=== Creating PR ==="
        curl -sS -X POST \
          -H "Authorization: Bearer ${GITHUB_TOKEN}" \
          -H "Accept: application/vnd.github+json" \
          https://api.github.com/repos/lucky-gun/kubernetes/pulls \
          -d @payload.json \
          | tee pr.json

        echo "=== PR url ==="
        grep -oE '"html_url"\\s*:\\s*"[^"]+"' pr.json || true
      '''
    }
  }
}

  }
}
