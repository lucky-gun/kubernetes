kubectl -n apps create secret generic wordpress-auth-keys \
  --from-literal=WORDPRESS_AUTH_KEY="$(openssl rand -base64 64)" \
  --from-literal=WORDPRESS_SECURE_AUTH_KEY="$(openssl rand -base64 64)" \
  --from-literal=WORDPRESS_LOGGED_IN_KEY="$(openssl rand -base64 64)" \
  --from-literal=WORDPRESS_NONCE_KEY="$(openssl rand -base64 64)" \
  --from-literal=WORDPRESS_AUTH_SALT="$(openssl rand -base64 64)" \
  --from-literal=WORDPRESS_SECURE_AUTH_SALT="$(openssl rand -base64 64)" \
  --from-literal=WORDPRESS_LOGGED_IN_SALT="$(openssl rand -base64 64)" \
  --from-literal=WORDPRESS_NONCE_SALT="$(openssl rand -base64 64)" \
  --dry-run=client -o yaml > wordpress-auth-keys.yaml
