pipeline {
    agent any
    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Create File') {
            steps {
                sh '''
                echo hello > hello.txt
                '''

                stash(
                    name: 'hello-file',
                    includes: 'hello.txt'
                )
            }
        }

        stage('Restore File') {
            steps {
                unstash 'hello-file'

                sh '''
                cat hello.txt
                '''
            }
        }
    }

    post {
        success {
            echo 'BUILD SUCCESS'
        }

        failure {
            echo 'BUILD FAILURE'
        }
        
        always {
            echo 'ALWAYS RUN'
        }

    }
}
