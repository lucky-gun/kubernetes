pipeline {
    agent any
    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Matrix Test') {
            matrix {
                axes {
                    axis {
                        name 'VERSION'
                        values 'v1','v2','v3'
                    }
                }

                stages {
                    stage('Print') {
                        steps {
                            echo "VERSION=${VERSION}"
                        }
                    }
                }
            }
        }
    }

    post {
        success {
            echo 'BUILD SUCCESS'
        }

        failure {
            echo 'BUILD FAILURE'
        }
        
        always {
            echo 'ALWAYS RUN'
        }

    }
}
