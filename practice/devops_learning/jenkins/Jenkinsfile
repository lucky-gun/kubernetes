pipeline {
    agent any
    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }
        stage ('Parallel Test') {
            parallel {
                stage('Job A') {
                    steps {
                        sh '''
                        echo START A
                        sleep 10
                        echo END A
                        '''
                    }
                }

                stage('Job B') {
                    steps {
                        sh '''
                        echo START B
                        sleep 10
                        echo END B
                        '''
                    }
                }
            }
        }
    }

    post {
        success {
            echo 'BUILD SUCCESS'
        }

        failure {
            echo 'BUILD FAILURE'
        }
        
        always {
            echo 'ALWAYS RUN'
        }

    }
}
